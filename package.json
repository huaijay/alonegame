{
  "name": "fxq-auto",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "游戏合集 · AI 自动对弈可视化（多游戏结构，当前含自动飞行棋）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/ts-loader.mjs --test ./tests/ludo/game-ai.test.mjs",
    "bench:ai": "node --import ./scripts/ts-loader.mjs ./scripts/bench-ai.mjs",
    "bench:ai:budgets": "node --import ./scripts/ts-loader.mjs ./scripts/bench-budgets.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
